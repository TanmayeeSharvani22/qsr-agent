# `make up` copies this file to .env on every run; edit settings here, not in .env.
MODEL_ROOT=./models
MODEL_ID=OpenVINO/Qwen3-8B-int4-ov
OVMS_PORT=4444
QSR_UI_PORT=8600
QSR_UI_HOST=0.0.0.0

# Callback URL for proactive event push. Must be reachable from the service
# machine/container. Leave blank to use each subscription's callback_url in
# agent-config/hermes/subscribe-events.yaml.
QSR_CALLBACK_URL=

# Optional: pin the Hermes installer revision for reproducible image builds.
HERMES_INSTALL_COMMIT=