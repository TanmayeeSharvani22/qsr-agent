# `make up` copies this file to .env on every run; edit settings here, not in .env.
MODEL_ROOT=${HOME}/models
MODEL_ID=OpenVINO/Qwen3-8B-int4-ov
OVMS_PORT=4444
QSR_UI_PORT=8600
QSR_UI_HOST=0.0.0.0

# Set these when SAD MCP is on another machine. The callback URL must be
# reachable from the SAD machine/container, not just from the QSR container.
QSR_SAD_MCP_URL=http://10.223.22.84:9000/mcp
QSR_CALLBACK_URL=http://10.223.22.84:8600/notifications

# Optional: pin the Hermes installer revision for reproducible image builds.
HERMES_INSTALL_COMMIT=