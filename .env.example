# Copy to .env to customize `make up`.
MODEL_ROOT=/home/YOUR_USER/models
MODEL_ID=OpenVINO/Qwen3-8B-int4-ov
OVMS_PORT=4444
QSR_UI_PORT=8600
QSR_UI_HOST=0.0.0.0

# Set these when SAD MCP is on another machine. The callback URL must be
# reachable from the SAD machine/container, not just from the QSR container.
QSR_SAD_MCP_URL=
QSR_CALLBACK_URL=

# Optional: pin the Hermes installer revision for reproducible image builds.
HERMES_INSTALL_COMMIT=

# Optional: PEM root CA used by an HTTPS-inspecting corporate proxy. Set the
# path here or pass `QSR_CA_CERT_FILE=/path/to/company-ca.crt` to make up.
# TLS verification stays enabled; this adds the CA to the image trust store.
QSR_CA_CERT_FILE=

# Certificate-free alternative: download this exact pinned Linux x86-64 uv
# archive on a trusted machine, verify its SHA-256 (see docs/setup.md), and set
# the path here. The image verifies the digest before staging uv for Hermes.
QSR_UV_ARCHIVE=